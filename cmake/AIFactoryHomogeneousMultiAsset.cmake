# Homogeneous five-equity/CIR catalog; generated by the maintainer scaffold.
add_custom_target(homogeneous_multi_mothers)
add_custom_target(homogeneous_multi_prices)
function(ai_factory_add_homogeneous_generator target is_cuda source)
    if(is_cuda)
        set_source_files_properties(${source} PROPERTIES LANGUAGE CUDA)
        set(group homogeneous_multi_prices)
        set(aggregate price_generators)
    else()
        set(group homogeneous_multi_mothers)
        set(aggregate parameter_generators)
    endif()
    add_executable(${target} EXCLUDE_FROM_ALL ${source})
    target_include_directories(${target} PRIVATE ${CMAKE_SOURCE_DIR} ${CMAKE_SOURCE_DIR}/src)
    target_link_libraries(${target} PRIVATE ${ARGN})
    add_dependencies(${group} ${target})
    add_dependencies(${aggregate} ${target})
endfunction()
